# Copy to server/.env and fill in. NEVER commit real values.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# MongoDB Atlas connection string (create a DB user first; see README)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wonderktm?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
COOKIE_DOMAIN=
# Storage: cloudinary | mongo | local (local is for development only)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_MB=5
# Email (optional). Leave blank to disable; the app will report email as not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Wonderktm <no-reply@example.com>
ADMIN_NOTIFY_EMAIL=
# One-time owner provisioning (used by `npm run create-owner`)
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
